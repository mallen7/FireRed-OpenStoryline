    },
    "can_decode_insv": {
      "title": "Can Decode Insv",
      "type": "boolean"
    },
    "can_stitch": {
      "title": "Can Stitch",
      "type": "boolean"
    },
    "supports_progress": {
      "title": "Supports Progress",
      "type": "boolean"
    },
    "supports_cancellation": {
      "title": "Supports Cancellation",
