  "required": [
    "worker_version",
    "provider",
    "sdk_enabled",
    "can_decode_insv",
    "can_stitch",
    "supports_progress",
    "supports_cancellation",
    "supported_codecs",
    "supported_stitch_types",
    "max_input_files",
    "requires_gpu",
