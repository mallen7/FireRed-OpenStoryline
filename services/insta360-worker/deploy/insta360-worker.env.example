# Copy to /etc/openstoryline/insta360-worker.env and replace every example path.
OPENSTORYLINE_WORKER_STATE_DIR=/var/lib/openstoryline-worker
OPENSTORYLINE_WORKER_MEDIA_ROOTS=/srv/openstoryline/media:/srv/openstoryline/uploads
OPENSTORYLINE_WORKER_OUTPUT_ROOTS=/srv/openstoryline/output
OPENSTORYLINE_WORKER_UPLOAD_ROOT=/srv/openstoryline/uploads
OPENSTORYLINE_WORKER_EXECUTABLE=/opt/openstoryline/bin/insta360-worker
OPENSTORYLINE_WORKER_TOKEN_FILE=/etc/openstoryline/insta360-worker.token
OPENSTORYLINE_WORKER_CONCURRENCY=1
OPENSTORYLINE_WORKER_MAX_QUEUED=100
OPENSTORYLINE_WORKER_TIMEOUT_SECONDS=86400
OPENSTORYLINE_WORKER_RETENTION_DAYS=30
OPENSTORYLINE_WORKER_REQUIRE_STITCH=1
OPENSTORYLINE_WORKER_HOST=0.0.0.0
OPENSTORYLINE_WORKER_PORT=8090
INSTA360_MODEL_ROOT=/opt/private/insta360-models
