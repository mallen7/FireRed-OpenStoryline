{
  "$defs": {
    "AnalysisBackendInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "object_detector": {
          "title": "Object Detector",
          "type": "string"
        },
        "person_detector": {
          "title": "Person Detector",
          "type": "string"
        },
        "face_detector": {
          "title": "Face Detector",
          "type": "string"
        },
        "subject_tracker": {
          "title": "Subject Tracker",
          "type": "string"
        },
        "shot_boundary_detector": {
          "title": "Shot Boundary Detector",
          "type": "string"
        },
        "visual_embedder": {
          "title": "Visual Embedder",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "optional_dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Optional Dependencies",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version",
        "object_detector",
        "person_detector",
        "face_detector",
        "subject_tracker",
        "shot_boundary_detector",
        "visual_embedder"
      ],
      "title": "AnalysisBackendInfo",
      "type": "object"
    },
    "CameraKeyframe": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "description": "Version of this JSON contract.",
          "title": "Schema Version",
          "type": "string"
        },
        "time_seconds": {
          "minimum": 0,
          "title": "Time Seconds",
          "type": "number"
        },
        "yaw": {
          "default": 0.0,
          "title": "Yaw",
          "type": "number"
        },
        "pitch": {
          "default": 0.0,
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Pitch",
          "type": "number"
        },
        "roll": {
          "default": 0.0,
          "title": "Roll",
          "type": "number"
        },
        "horizontal_fov": {
          "default": 90.0,
          "exclusiveMaximum": 179.0,
          "exclusiveMinimum": 1.0,
          "title": "Horizontal Fov",
          "type": "number"
        },
        "easing": {
          "$ref": "#/$defs/Easing",
          "default": "linear"
        },
        "subject_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "time_seconds"
      ],
      "title": "CameraKeyframe",
      "type": "object"
    },
    "Easing": {
      "enum": [
        "linear",
        "smoothstep",
        "ease_in",
        "ease_out",
        "ease_in_out"
      ],
      "title": "Easing",
      "type": "string"
    },
    "SuggestionPolicy": {
      "enum": [
        "subject_center",
        "rule_of_thirds",
        "largest_person",
        "wide_establishing",
        "pan_subjects",
        "static_direction",
        "group"
      ],
      "title": "SuggestionPolicy",
      "type": "string"
    },
    "SuggestionStatus": {
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ],
      "title": "SuggestionStatus",
      "type": "string"
    },
    "TrackCreatedBy": {
      "enum": [
        "manual",
        "assisted",
        "director"
      ],
      "title": "TrackCreatedBy",
      "type": "string"
    },
    "VirtualCameraTrack": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "description": "Version of this JSON contract.",
          "title": "Schema Version",
          "type": "string"
        },
        "track_id": {
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "output_width": {
          "exclusiveMinimum": 0,
          "title": "Output Width",
          "type": "integer"
        },
        "output_height": {
          "exclusiveMinimum": 0,
          "title": "Output Height",
          "type": "integer"
        },
        "source_start_seconds": {
          "minimum": 0,
          "title": "Source Start Seconds",
          "type": "number"
        },
        "source_end_seconds": {
          "exclusiveMinimum": 0,
          "title": "Source End Seconds",
          "type": "number"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/CameraKeyframe"
          },
          "minItems": 1,
          "title": "Keyframes",
          "type": "array"
        },
        "created_by": {
          "$ref": "#/$defs/TrackCreatedBy",
          "default": "manual"
        },
        "generation_metadata": {
          "additionalProperties": true,
          "title": "Generation Metadata",
          "type": "object"
        }
      },
      "required": [
        "track_id",
        "asset_id",
        "name",
        "output_width",
        "output_height",
        "source_start_seconds",
        "source_end_seconds",
        "keyframes"
      ],
      "title": "VirtualCameraTrack",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "description": "Version of this JSON contract.",
      "title": "Schema Version",
      "type": "string"
    },
    "suggestion_id": {
      "minLength": 1,
      "title": "Suggestion Id",
      "type": "string"
    },
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/SuggestionPolicy"
    },
    "status": {
      "$ref": "#/$defs/SuggestionStatus",
      "default": "proposed"
    },
    "subject_ids": {
      "items": {
        "type": "string"
      },
      "title": "Subject Ids",
      "type": "array"
    },
    "camera_track": {
      "$ref": "#/$defs/VirtualCameraTrack"
    },
    "analysis_backend": {
      "$ref": "#/$defs/AnalysisBackendInfo"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "camera_trajectory_path": {
      "format": "path",
      "title": "Camera Trajectory Path",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "suggestion_id",
    "analysis_id",
    "asset_id",
    "policy",
    "camera_track",
    "analysis_backend",
    "confidence",
    "camera_trajectory_path"
  ],
  "title": "ReframeSuggestion",
  "type": "object"
}
