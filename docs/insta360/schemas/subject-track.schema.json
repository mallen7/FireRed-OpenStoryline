      "title": "Subject Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "start_seconds": {
      "minimum": 0,
      "title": "Start Seconds",
      "type": "number"
