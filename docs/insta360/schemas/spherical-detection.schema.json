{
  "$defs": {
    "DetectionKind": {
      "enum": [
        "object",
        "person",
        "face"
      ],
      "title": "DetectionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "description": "Version of this JSON contract.",
      "title": "Schema Version",
      "type": "string"
    },
    "detection_id": {
      "minLength": 1,
      "title": "Detection Id",
      "type": "string"
    },
    "timestamp_seconds": {
      "minimum": 0,
      "title": "Timestamp Seconds",
      "type": "number"
    },
    "yaw": {
      "title": "Yaw",
      "type": "number"
    },
    "pitch": {
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Pitch",
      "type": "number"
    },
    "angular_width": {
      "exclusiveMinimum": 0.0,
      "maximum": 180.0,
      "title": "Angular Width",
      "type": "number"
    },
    "angular_height": {
      "exclusiveMinimum": 0.0,
      "maximum": 180.0,
      "title": "Angular Height",
      "type": "number"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "kinds": {
      "items": {
        "$ref": "#/$defs/DetectionKind"
      },
      "minItems": 1,
      "title": "Kinds",
      "type": "array"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Labels",
      "type": "array"
    },
    "source_viewports": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Viewports",
      "type": "array"
    },
    "detector_backends": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Detector Backends",
      "type": "array"
    },
    "embedding": {
      "items": {
        "type": "number"
      },
      "maxItems": 512,
      "title": "Embedding",
      "type": "array"
    },
    "identity_evidence": {
      "additionalProperties": true,
      "title": "Identity Evidence",
      "type": "object"
    }
  },
  "required": [
    "detection_id",
    "timestamp_seconds",
    "yaw",
    "pitch",
    "angular_width",
    "angular_height",
    "confidence",
    "kinds",
    "labels",
    "source_viewports",
    "detector_backends"
  ],
  "title": "SphericalDetection",
  "type": "object"
}
