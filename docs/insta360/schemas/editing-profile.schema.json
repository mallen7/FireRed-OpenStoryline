{
  "$defs": {
    "VerticalOutputBehavior": {
      "enum": [
        "center_crop",
        "active_subject",
        "group_when_uncertain"
      ],
      "title": "VerticalOutputBehavior",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
